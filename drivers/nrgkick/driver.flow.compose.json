  "actions": [
    {
      "id": "set_current",
      "title": {
        "en": "Set the charging current",
        "nl": "Stel de laadstroom in",
        "fr": "Régler le courant de charge"
      },
      "titleFormatted": {
        "en": "Set the charging current to [[current]] A",
        "nl": "Stel de laadstroom in op [[current]] A",
        "fr": "Régler le courant de charge à [[current]] A"
      },
      "hint": {
        "en": "From 6 A up to the maximum of the NRGkick and its attachment. Higher values are capped.",
        "nl": "Van 6 A tot het maximum van de NRGkick en zijn adapter. Hogere waarden worden begrensd.",
        "fr": "De 6 A jusqu'au maximum du NRGkick et de son adaptateur. Les valeurs plus élevées sont plafonnées."
      },
      "args": [
        {
          "name": "current",
          "type": "number",
          "min": 6,
          "max": 32,
          "step": 0.1,
          "placeholder": {
