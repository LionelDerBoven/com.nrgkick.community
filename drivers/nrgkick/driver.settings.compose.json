        "value": 30,
        "min": 10,
        "max": 300,
        "units": {
          "en": "s"
        },
        "label": {
          "en": "Update interval",
          "nl": "Update-interval",
          "fr": "Intervalle de mise à jour"
        },
        "hint": {
          "en": "How often Homey reads the NRGkick. Shorter is more responsive, longer is lighter for Homey and the network.",
          "nl": "Hoe vaak Homey de NRGkick uitleest. Korter reageert sneller, langer is lichter voor Homey en het netwerk.",
          "fr": "Fréquence de lecture du NRGkick par Homey. Plus court réagit plus vite, plus long allège Homey et le réseau."
        }
